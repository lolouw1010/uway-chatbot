# Primary provider (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Vertex AI authentication when GEMINI_API_KEY is empty.
# Prefer Workload Identity/ADC; a key-file path is supported for the existing GCP migration only.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Fallback provider (OpenAI-compatible Agnes AI)
AGNES_API_KEY=
AGNES_MODEL=agnes-2.0-flash
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Optional: comma-separated provider order. Supported values: gemini, agnes
MODEL_PROVIDER_ORDER=gemini,agnes
