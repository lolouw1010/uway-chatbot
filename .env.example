# Primary provider (Vertex AI Express mode by default)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_ENABLE_GOOGLE_SEARCH=true

# Optional full Vertex AI authentication when GEMINI_API_KEY is empty.
# Prefer Workload Identity/ADC; a key-file path is supported only for an existing GCP migration.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Fallback provider (OpenAI-compatible Agnes AI)
AGNES_API_KEY=
AGNES_MODEL=agnes-2.0-flash
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Optional: comma-separated provider order. Supported values: gemini, agnes
MODEL_PROVIDER_ORDER=gemini,agnes

# Telegram Bot API webhook. TELEGRAM_BOT_USERNAME must not include @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=

# Lark custom app bot. Leave event payload encryption disabled for this webhook.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=
LARK_OPEN_API_BASE_URL=https://open.larksuite.com
LARK_ALLOWED_CHAT_IDS=

# Authenticates UWAY billing/operations systems that send confirmed notices.
CHANNEL_NOTIFY_SECRET=
CHANNEL_RATE_LIMIT_MAX=6
CHANNEL_RATE_LIMIT_WINDOW_MS=60000
